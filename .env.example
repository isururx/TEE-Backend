# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Local development only. Use a private, strong secret outside local development.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gmail SMTP example:
# 1. Enable 2-Step Verification on the sender Google account.
# 2. Create a Google App Password (not your normal Gmail password).
# 3. Put the App Password below without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_NAME=TEE Estate System
SMTP_FROM_EMAIL=your-sender@gmail.com

# For providers using implicit TLS, use SMTP_PORT=465.
